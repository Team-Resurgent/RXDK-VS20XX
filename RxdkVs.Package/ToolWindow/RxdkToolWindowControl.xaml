<UserControl x:Class="RxdkVs.Package.ToolWindow.RxdkToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="640" d:DesignWidth="300">
    <UserControl.Resources>
        <!-- Original-Xbox lime accent; reads on both light and dark themes. -->
        <SolidColorBrush x:Key="Accent" Color="#84BD00" />
        <SolidColorBrush x:Key="HoverFill" Color="#22808080" />
        <SolidColorBrush x:Key="PressFill" Color="#40808080" />

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,16,0,5" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Full-width action button: rounded, left-aligned, highlights on hover. -->
        <Style x:Key="Act" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Padding="11,0" Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverFill}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PressFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowBorderBrushKey}}" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12,12,16">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="RXDK" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,4"
                       Text="Build, deploy and debug are native VS: press F5, or right-click the project and Build. Deploy to Xbox / Remove DXT are on the project's right-click menu." />

            <!-- Xbox console card -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="XBOX CONSOLE" Style="{StaticResource Section}" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="SetIpButton" Style="{StaticResource Act}" Content="Set…" DockPanel.Dock="Right"
                                Width="56" HorizontalContentAlignment="Center" Margin="8,0,0,0" Click="OnSetIp" />
                        <TextBlock x:Name="IpText" Text="(unknown)" FontSize="15" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Button Style="{StaticResource Act}" Content="Warm Reboot Xbox" Click="OnReboot" />
                </StackPanel>
            </Border>

            <!-- Components (installed vs available) -->
            <DockPanel Margin="0,16,0,0">
                <Button x:Name="UpdateAllButton" Style="{StaticResource Act}" Content="Update All"
                        DockPanel.Dock="Right" Width="86" HorizontalContentAlignment="Center"
                        Margin="8,0,0,0" Click="OnUpdateAll" />
                <TextBlock Text="COMPONENTS" Style="{StaticResource Section}" Margin="2,0,0,0"
                           VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel x:Name="ComponentsPanel" Margin="12,4,0,0" />

            <!-- Folders -->
            <TextBlock Text="FOLDERS" Style="{StaticResource Section}" />
            <Button Style="{StaticResource Act}" Content="Open SDK Folder (include/lib)" Click="OnOpenSdkFolder" />
            <Button Style="{StaticResource Act}" Content="Open Host Tools Folder"        Click="OnOpenToolsFolder" />
            <Button Style="{StaticResource Act}" Content="Open Documentation Folder"     Click="OnOpenDocsFolder" />
            <Button x:Name="DownloadSamplesButton" Style="{StaticResource Act}" Content="Download RXDK Samples" Click="OnDownloadSamples" />
            <Button Style="{StaticResource Act}" Content="Open Samples Folder"            Click="OnOpenSamplesFolder" />

            <!-- Documentation -->
            <TextBlock Text="DOCUMENTATION" Style="{StaticResource Section}" />
            <Button Style="{StaticResource Act}" Content="Xbox SDK Documentation"  Click="OnOpenSdkDocs" />
            <Button Style="{StaticResource Act}" Content="Extension Documentation" Click="OnOpenExtensionDocs" />

            <!-- Tools -->
            <TextBlock Text="TOOLS" Style="{StaticResource Section}" />
            <Button Style="{StaticResource Act}" Content="Launch xbWatson"               Click="OnLaunchXbwatson" />
            <Button Style="{StaticResource Act}" Content="Xbox Neighborhood (App)"        Click="OnLaunchNeighborhoodApp" />
            <Button Style="{StaticResource Act}" Content="Xbox Neighborhood (Explorer)"   Click="OnOpenXboxNeighborhood" />
            <Button Style="{StaticResource Act}" Content="Install Xbox Neighborhood"       Click="OnInstallXboxNeighborhood" />
            <Button Style="{StaticResource Act}" Content="Cycle Globals Visibility (Title / +Constants / All)" Click="OnCycleGlobals" />

            <!-- Project -->
            <TextBlock Text="PROJECT" Style="{StaticResource Section}" />
            <Button Style="{StaticResource Act}" Content="Import VS2003 Project / Solution…" Click="OnImportProject" />

            <!-- Setup -->
            <TextBlock Text="SETUP" Style="{StaticResource Section}" />
            <!-- One-click: installs C++ build tools, the Xbox platform, and the CLI-managed
                 components (Zig/tools/SDK/docs), skipping whatever is already present. The
                 individual installers remain available via the RXDK command menu. -->
            <Button x:Name="InstallPrereqsButton" Style="{StaticResource Act}" Content="Install Prerequisites"       Click="OnCompleteSetup" />
            <Button Style="{StaticResource Act}" Content="Settings"                Click="OnSettings" />
            <Button Style="{StaticResource Act}" Content="Refresh"                 Click="OnRefresh" />

            <Separator Margin="0,12,0,8" Opacity="0.4" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
