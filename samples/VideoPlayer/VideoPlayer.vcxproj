<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox">
      <Configuration>Debug</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox">
      <Configuration>Release</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{A6666666-6666-4666-8666-666666666666}</ProjectGuid>
    <RootNamespace>XboxNamespace</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>VideoPlayer</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <!-- Real VC++ Linker property (Additional Dependencies): exact filenames
         including .lib, nothing appended automatically — $(RxdkLibSuffix) is this
         project's own explicit choice, same as picking libd3d8d.lib vs libd3d8.lib
         by hand. -->
    <Link>
      <AdditionalDependencies>libxapi$(RxdkLibSuffix).lib;libd3d8$(RxdkLibSuffix).lib;libdsound$(RxdkLibSuffix).lib;libxmv$(RxdkLibSuffix).lib;libc$(RxdkLibSuffix).lib;libcpp$(RxdkLibSuffix).lib;libkernel$(RxdkLibSuffix).lib;libcompat$(RxdkLibSuffix).lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <PropertyGroup>
    <!-- Copied next to default.xbe on deploy (streamed at runtime). -->
    <RxdkDeployPaths>media/test.xmv</RxdkDeployPaths>
    <!-- Baked into the XBE as a named section (path|name). -->
    <RxdkEmbed>media/dsstdfx.bin|dsstdfx</RxdkEmbed>
    <NMakeOutput>$(MSBuildProjectDirectory)\$(RxdkOutDir)\$(MSBuildProjectName).xbe</NMakeOutput>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="media\test.xmv" />
    <None Include="media\dsstdfx.bin" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
