# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

packages/

# Scratch sweep/probe logs and screenshots written at the repo root
/_*

# VS / Rider
.vs/
.idea/

# VSIX build artifacts
*.vsix

# Xbox sample build output (Rxdk.Cli writes into each project's out/)
out/
*.xbe
*.iso
*.dxt

# Generated VS project-template zips (packed from TemplateSrc by dev.ps1 templates)
RxdkVs.Package/ProjectTemplates/*.zip

# Scaffold files staged from samples\ by dev.ps1 templates (source of truth is samples\)
RxdkVs.Package/Scaffold/

# Bundler-generated resource outputs in the imported XDK samples (regenerated by the build)
XDKSamples/**/*.xpr
XDKSamples/**/*.err

# xactbld generated outputs (regenerated from each .xap at build time)
XDKSamples/**/*.xsb
XDKSamples/**/*.xwb
XDKSamples/**/XactSounds.h
XDKSamples/**/XactSounds.txt
XDKSamples/**/XACTSounds.h
XDKSamples/**/XACTSounds.txt

# Build byproducts the bundler / xactbld / srbld generate next to the sample
# sources. They are outputs, not sources -- regenerated on every build.
XDKSamples/Input/DebugKeyboard/systemfont.h
XDKSamples/Networking/Auth/OnlineFont.h
XDKSamples/Networking/Auth/OnlineIconsFont.h
XDKSamples/Networking/UIXKeyboard/audio.txt
XDKSamples/Networking/UIXKeyboard/ressound.h
XDKSamples/Graphics/PerPixelLighting/Resource.h
XDKSamples/Graphics/XRay/Resource.h
