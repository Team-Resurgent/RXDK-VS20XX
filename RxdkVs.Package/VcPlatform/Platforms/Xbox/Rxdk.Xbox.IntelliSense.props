<?xml version="1.0" encoding="utf-8"?>
<!--
  RXDK IntelliSense settings for native Xbox (.vcxproj Makefile) projects, imported via
  ForceImportAfterCppTargets (set in this platform's Platform.props) so it evaluates AFTER
  Microsoft.Cpp.targets — by which point the project's per-configuration Rxdk* settings
  (RxdkIncludePaths/RxdkDefines/…) are populated. Setting these earlier captures empty values and
  IntelliSense fails to find the project's own headers (e.g. the sample framework in Common\include).

  The build itself does NOT use these; it reads the generated manifest. These only shape the VS
  IntelliSense (MSVC front-end) view: squiggles, go-to-definition, completion. Lives in the installed
  Xbox platform folder (no per-project copy).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NMakePreprocessorDefinitions>_XBOX;XBOX;$(RxdkDefines);$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <!-- The IntelliSense shim dir supplies the freestanding/Windows-compat headers the SDK expects
         (stddef, stdarg, float, pshpack, …) which the clang build gets from the LLVM toolchain but the
         MSVC IntelliSense front-end otherwise can't find — a missing one aborts the parse and every
         symbol reads as "not found". -->
    <NMakeIncludeSearchPath>$(RxdkSdkInclude);$(RxdkIntelliSenseInclude);$(RxdkIncludePaths);$(RxdkPublicIncludePaths);$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <!-- rxdk_intellisense.h (the clang-builtin/attribute prelude) must be first, before the SDK headers. -->
    <NMakeForcedIncludes>rxdk_intellisense.h;picolibc.h;$(NMakeForcedIncludes)</NMakeForcedIncludes>
  </PropertyGroup>
</Project>
