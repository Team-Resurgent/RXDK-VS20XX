<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Xbox">
      <Configuration>Debug</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Xbox">
      <Configuration>Release</Configuration>
      <Platform>Xbox</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{$guid1$}</ProjectGuid>
    <Keyword>RXDK</Keyword>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
    <ApplicationType>RXDK</ApplicationType>
    <ApplicationTypeRevision>Current</ApplicationTypeRevision>
    <RootNamespace>XboxNamespace</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>$safeprojectname$</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Xbox'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>RXDK</PlatformToolset>
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>RXDK</PlatformToolset>
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <!-- Real VC++ Linker property (Additional Dependencies): exact filenames including .lib,
       nothing appended automatically. $(D) (Debug -> "d", Release -> "") is this project's
       own explicit choice, same as picking libd3d8d.lib vs libd3d8.lib by hand. -->
  <ItemDefinitionGroup>
    <Link>
      <LibraryDependencies>libxapi$(D);libd3d8$(D);libdsound$(D);libxmv$(D);libc$(D);libcpp$(D);libkernel$(D)</LibraryDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Streamed at runtime; staged flat next to default.xbe in the ISO. -->
    <IsoCopy Include="media\test.xmv" />
    <!-- Baked into the XBE as a named section (imagebld /insertfile), read back at runtime by name. -->
    <RxdkEmbed Include="media\dsstdfx.bin">
      <Name>dsstdfx</Name>
    </RxdkEmbed>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
