{
  "name": "$safeprojectname$",
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "configuration": "debug",
      "sources": [
        "src/main.cpp"
      ],
      "libraries": [
        "libd3d8",
        "libdsound",
        "libxapi",
        "libc",
        "libcpp",
        "libkernel"
      ],
      "projectReferences": [
        "../vorbis/"
      ],
      "deployPaths": [
        "media"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Debug"
    },
    "Release": {
      "configuration": "release",
      "sources": [
        "src/main.cpp"
      ],
      "libraries": [
        "libd3d8",
        "libdsound",
        "libxapi",
        "libc",
        "libcpp",
        "libkernel"
      ],
      "projectReferences": [
        "../vorbis/"
      ],
      "deployPaths": [
        "media"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Release"
    }
  }
}
