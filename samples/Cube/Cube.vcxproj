    <ProjectReference Include="libs\cubemesh\cubemesh.vcxproj">
      <Project>{C5555555-5555-4555-8555-555555555555}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
