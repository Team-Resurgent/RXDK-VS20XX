<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!--
    RXDK command table. Defines a top-level "RXDK" menu on the main menu bar with grouped
    buttons that mirror RXDK-VSCode's contributes.commands. The same buttons are surfaced
    by the tool window's WPF buttons (which route through the same OleMenuCommandService),
    so this table is the canonical command surface.

    GUIDs/IDs here MUST match RxdkPackageGuids.cs + Commands/CommandIds.cs.
  -->
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidRxdkPackage">

    <Menus>
      <!-- Top-level "RXDK" menu, placed on the main menu bar. -->
      <Menu guid="guidRxdkCmdSet" id="RxdkTopMenu" priority="0x0700" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>RXDK</ButtonText>
          <CommandName>RXDK</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <!-- Single group on the top-level RXDK menu. Everything else now lives in the RXDK tool
           window (the hub), so the menu just opens it. -->
      <Group guid="guidRxdkCmdSet" id="RxdkMainGroup" priority="0x0100">
        <Parent guid="guidRxdkCmdSet" id="RxdkTopMenu" />
      </Group>
      <!-- Per-project commands on the Solution Explorer project-node context menu. Shown only
           for RXDK projects (dynamic visibility set in RxdkCommands.BeforeQueryStatus). -->
      <Group guid="guidRxdkCmdSet" id="RxdkProjectCtxGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_PROJNODE" />
      </Group>
    </Groups>

    <Buttons>
      <!-- The only top-menu entry: open the RXDK tool window (build/deploy/run/debug are native VS
           now — F5 / right-click Build / the relabelled green button). -->
      <Button guid="guidRxdkCmdSet" id="CmdShowToolWindow" priority="0x0100" type="Button">
        <Parent guid="guidRxdkCmdSet" id="RxdkMainGroup" />
        <Strings><ButtonText>RXDK Window</ButtonText></Strings>
      </Button>

      <!-- Download + launch XboxNeighborhood-Setup.exe (registers the Explorer shell namespace
           extension). Also surfaced by the tool window's TOOLS section. -->
      <Button guid="guidRxdkCmdSet" id="CmdInstallXboxNeighborhood" priority="0x0110" type="Button">
        <Parent guid="guidRxdkCmdSet" id="RxdkMainGroup" />
        <Strings><ButtonText>Install Xbox Neighborhood</ButtonText></Strings>
      </Button>

      <!-- Project context menu: Deploy (all RXDK Xbox projects) + Remove DXT (DXT projects only).
           DynamicVisibility + DefaultInvisible so BeforeQueryStatus decides per selection. -->
      <Button guid="guidRxdkCmdSet" id="CmdDeployProject" priority="0x0100" type="Button">
        <Parent guid="guidRxdkCmdSet" id="RxdkProjectCtxGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Deploy to Xbox</ButtonText></Strings>
      </Button>
      <Button guid="guidRxdkCmdSet" id="CmdRemoveDxt" priority="0x0110" type="Button">
        <Parent guid="guidRxdkCmdSet" id="RxdkProjectCtxGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Remove DXT &amp; Reboot</ButtonText></Strings>
      </Button>
      <Button guid="guidRxdkCmdSet" id="CmdLaunchXemu" priority="0x0120" type="Button">
        <Parent guid="guidRxdkCmdSet" id="RxdkProjectCtxGroup" />
        <CommandFlag>DynamicVisibility</CommandFlag>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <Strings><ButtonText>Launch in xemu</ButtonText></Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <!-- The strip's usedList maps 1-based slot indices to the named ids below.
           Replace Resources\RxdkCommands.png with a real 16x16-per-icon strip. -->
      <Bitmap guid="guidRxdkImages" href="Resources\RxdkCommands.png"
              usedList="bmpBuild, bmpDeploy, bmpRun, bmpDebug, bmpNew, bmpSetup" />
    </Bitmaps>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidRxdkPackage" value="{c5390b93-36ff-4de6-9ca3-3776d9c709bb}" />

    <GuidSymbol name="guidRxdkCmdSet" value="{5652ff38-066f-4c97-bc61-212735f299f9}">
      <!-- Menus / groups. -->
      <IDSymbol name="RxdkTopMenu" value="0x1000" />
      <IDSymbol name="RxdkMainGroup" value="0x1100" />
      <IDSymbol name="RxdkConsoleGroup" value="0x1200" />
      <IDSymbol name="RxdkProjectGroup" value="0x1300" />
      <IDSymbol name="RxdkToolsGroup" value="0x1400" />
      <IDSymbol name="RxdkSetupGroup" value="0x1500" />
      <IDSymbol name="RxdkProjectCtxGroup" value="0x1600" />

      <!-- Buttons (must equal Commands/CommandIds.cs). -->
      <IDSymbol name="CmdSetupPrerequisites" value="0x0101" />
      <IDSymbol name="CmdNewProject" value="0x0102" />
      <IDSymbol name="CmdBuild" value="0x0103" />
      <IDSymbol name="CmdDeploy" value="0x0104" />
      <IDSymbol name="CmdRun" value="0x0105" />
      <IDSymbol name="CmdRemoveDxt" value="0x0106" />
      <IDSymbol name="CmdRebootConsole" value="0x0107" />
      <IDSymbol name="CmdDebug" value="0x0108" />
      <IDSymbol name="CmdInstallXboxNeighborhood" value="0x0109" />
      <IDSymbol name="CmdSetXboxIp" value="0x010A" />
      <IDSymbol name="CmdShowToolWindow" value="0x010B" />
      <IDSymbol name="CmdOpenSdkDocs" value="0x010C" />
      <IDSymbol name="CmdOpenExtensionDocs" value="0x010D" />
      <IDSymbol name="CmdOpenSdkFolder" value="0x010E" />
      <IDSymbol name="CmdOpenToolsFolder" value="0x010F" />
      <IDSymbol name="CmdOpenDocsFolder" value="0x0110" />
      <IDSymbol name="CmdFetchLatestSdk" value="0x0111" />
      <IDSymbol name="CmdInstallDotNet" value="0x0112" />
      <IDSymbol name="CmdLaunchXbwatson" value="0x0113" />
      <IDSymbol name="CmdLaunchXbNeighborhood" value="0x0114" />
      <IDSymbol name="CmdOpenXboxNeighborhood" value="0x0115" />
      <IDSymbol name="CmdSetBuildType" value="0x0117" />
      <IDSymbol name="CmdOpenSettings" value="0x0118" />
      <IDSymbol name="CmdDeployProject" value="0x0119" />
      <IDSymbol name="CmdLaunchXemu" value="0x011B" />
    </GuidSymbol>

    <GuidSymbol name="guidRxdkImages" value="{89c8f7ba-434f-466d-b59a-629e92d80e63}">
      <IDSymbol name="bmpBuild" value="1" />
      <IDSymbol name="bmpDeploy" value="2" />
      <IDSymbol name="bmpRun" value="3" />
      <IDSymbol name="bmpDebug" value="4" />
      <IDSymbol name="bmpNew" value="5" />
      <IDSymbol name="bmpSetup" value="6" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
