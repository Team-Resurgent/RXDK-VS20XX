<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    RXDK for Visual Studio — classic in-process VSIX (.NET Framework 4.7.2).

    This is deliberately the OLD-style, non-SDK csproj that the VSSDK build tooling
    expects: it imports Microsoft.Common.props / .targets and the VSSDK targets by
    convention, uses <ProjectTypeGuids> to mark it as a VSIX + C# project, and relies
    on Microsoft.VSSDK.BuildTools to produce the .vsix.

    It will NOT restore/build unless the "Visual Studio extension development" workload
    (Microsoft.VSSDK.BuildTools + the VS SDK reference assemblies) is installed. See
    README.md. `nuget restore` + `msbuild RxdkVs.Package.csproj` from a Developer prompt
    is the intended build path; `dotnet build` on this project is NOT supported.
  -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{c5390b93-36ff-4de6-9ca3-3776d9c709bb}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>RxdkVs.Package</RootNamespace>
    <AssemblyName>RxdkVs.Package</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- First GUID = VSIX/VSPackage project type; second = C#. -->
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>

    <!-- Deploy into the experimental hive on F5 so debugging the VSIX doesn't disturb
         the real VS install. -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <UseCodebase>true</UseCodebase>

    <!-- Deploy VSIX on build so F5 into the experimental instance just works. -->
    <DeployExtension>true</DeployExtension>

    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- System.ComponentModel.Design.MenuCommandService (OleMenuCommandService base). -->
    <Reference Include="System.Design" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- FolderBrowserDialog for the Import Project wizard. -->
    <Reference Include="System.Windows.Forms" />
    <!-- System.Drawing.Color, used by the docs viewer to map VS theme colors to CSS. -->
    <Reference Include="System.Drawing" />
    <!-- WPF, used by the tool window control. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <!-- Automation object model (DTE). Interop types embedded so no extra file ships. -->
    <Reference Include="EnvDTE">
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RxdkPackage.cs" />
    <Compile Include="RxdkPackageGuids.cs" />
    <Compile Include="Options\RxdkOptionsPage.cs" />
    <Compile Include="Commands\CommandIds.cs" />
    <Compile Include="Commands\RxdkCommands.cs" />
    <Compile Include="Commands\StartDebugInterceptor.cs" />
    <Compile Include="Services\XboxDebugLauncher.cs" />
    <Compile Include="Services\TitleOutputPane.cs" />
    <Compile Include="Services\CliRunner.cs" />
    <Compile Include="Services\ExtensionInfo.cs" />
    <Compile Include="Services\EngineStager.cs" />
    <Compile Include="Services\ToolLocator.cs" />
    <Compile Include="Services\ProjectConfigGenerator.cs" />
    <Compile Include="Services\OpenFolderContext.cs" />
    <Compile Include="ToolWindow\RxdkToolWindow.cs" />
    <Compile Include="ToolWindow\RxdkToolWindowControl.xaml.cs">
      <DependentUpon>RxdkToolWindowControl.xaml</DependentUpon>
    </Compile>
    <Compile Include="ToolWindow\DocsToolWindow.cs" />
    <Compile Include="ToolWindow\DocsToolWindowControl.xaml.cs">
      <DependentUpon>DocsToolWindowControl.xaml</DependentUpon>
    </Compile>
    <Compile Include="Services\DocsShell.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="ToolWindow\RxdkToolWindowControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="ToolWindow\DocsToolWindowControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <!-- Static .pkgdef registering the "xbox" debug adapter with the VS Debug Adapter Host.
         Distinct filename from the generated RxdkVs.Package.pkgdef so both ship (the VSSDK
         merges every *.pkgdef in the extension folder at registration time). Content +
         IncludeInVSIX is how the VSSDK packages a loose static pkgdef into the container. -->
    <!-- VS project templates. The .zip files are generated by scripts/dev.ps1 templates
         (from TemplateSrc\*) before the VSIX build; each is registered in the manifest. -->
    <Content Include="ProjectTemplates\*.zip">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ProjectTemplates</VSIXSubPath>
    </Content>
    <Content Include="DebugAdapterHost.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Custom 'Xbox' MSBuild platform (a thin alias to x64). The "Install Xbox Platform"
         command copies this into each VS install's VCTargetsPath\Platforms so RXDK .vcxproj
         projects (Platform=Xbox) load and build. Shipped under the extension's VcPlatform\. -->
    <Content Include="VcPlatform\**\*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>VcPlatform\%(RecursiveDir)</VSIXSubPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="RxdkPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <!-- Command-bar bitmap strip referenced by the .vsct (6x 16x16 icons). The checked-in
         PNG is a colored-square placeholder; replace with real 16x16 command icons. -->
    <Content Include="Resources\RxdkCommands.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Manifest assets: the extension icon/preview and the license shown in the installer. -->
    <Content Include="Resources\extension-icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.9.3168" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The VS 2022-era meta-package; pulls in the shell, editor, debugger, and
         Debug Adapter Host reference assemblies. 17.x targets VS 2022 and remains
         binary-compatible into the VS 2026 (18.0) range declared in the manifest. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.9.37000" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- System.Text.Json is not in the .NET Framework BCL; ProjectConfigGenerator uses it to
         read rxdk.project.json and write tasks.vs.json/launch.vs.json/CppProperties.json.
         The assembly must ship in the VSIX (IncludeInVSIXContainer picks it up as a dependency). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- WebView2 SDK for the internal documentation viewer (DocsToolWindow). The Edge WebView2
         runtime ships with VS 2022; this NuGet supplies the managed control + native loader. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!--
    The VSSDK build/ targets (auto-imported by the NuGet package) only set env vars and
    register BeforeTargets hooks; the actual CreateVsixContainer / GeneratePkgDef / VSCTCompile
    targets live in tools/vssdk/Microsoft.VsSDK.targets and must be imported explicitly for an
    old-style (non-SDK) csproj. GeneratePathProperty on the PackageReference above gives us
    $(PkgMicrosoft_VSSDK_BuildTools) to locate it in the restored package.
  -->
  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets"
          Condition="Exists('$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets')" />

  <!--
    Bundle the matching net8 engine (Rxdk.Cli + Rxdk.Dap, framework-dependent) into the VSIX
    under tools\. ToolLocator resolves <extensionDir>\tools FIRST, so the installed extension
    always runs the CLI/adapter that shipped with it — a VSIX upgrade can never leave a stale
    %ProgramData%\RXDK\engine copy in charge (the bug this fixes). Set BundleEngine=false to skip
    the publish for a faster inner loop (dev.ps1 keeps %ProgramData%\RXDK\engine current as the
    fallback). Hooks GetVsixSourceItems, the VSSDK's extension point for computed VSIX content.
  -->
  <PropertyGroup>
    <BundleEngine Condition="'$(BundleEngine)' == ''">true</BundleEngine>
    <EngineStageDir>$(IntermediateOutputPath)engine\</EngineStageDir>
  </PropertyGroup>
  <Target Name="PublishRxdkEngine" BeforeTargets="GetVsixSourceItems" Condition="'$(BundleEngine)' == 'true'">
    <Message Importance="high" Text="RXDK: publishing net8 engine (Rxdk.Cli + Rxdk.Dap) into the VSIX under tools\ ..." />
    <RemoveDir Directories="$(EngineStageDir)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\external\RXDK-Tools\src\Rxdk.Cli\Rxdk.Cli.csproj&quot; -c $(Configuration) --no-self-contained -o &quot;$(EngineStageDir.TrimEnd('\'))&quot; -v quiet -nologo" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\external\RXDK-Tools\src\Rxdk.Dap\Rxdk.Dap.csproj&quot; -c $(Configuration) --no-self-contained -o &quot;$(EngineStageDir.TrimEnd('\'))&quot; -v quiet -nologo" />
    <ItemGroup>
      <!-- Ship the runnable closure, not debug/build cruft. -->
      <_RxdkEngineFile Include="$(EngineStageDir)**\*"
                       Exclude="$(EngineStageDir)**\*.pdb;$(EngineStageDir)**\*.xml" />
      <VSIXSourceItem Include="@(_RxdkEngineFile)">
        <VSIXSubPath>tools\%(RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!--
    Publish the VSIX under a versioned, product-branded name (rxdk-vs-<version>.vsix) beside the raw
    RxdkVs.Package.vsix the VSSDK produces, mirroring RXDK-VSCode's rxdk-vscode-<version>.vsix. The
    version is read from the vsixmanifest Identity so it can't drift from the extension's real version.
  -->
  <Target Name="RenameVsixToProductName" AfterTargets="CreateVsixContainer">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\source.extension.vsixmanifest"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version">
      <Output TaskParameter="Result" ItemName="_RxdkVsixVersion" />
    </XmlPeek>
    <PropertyGroup>
      <_RxdkVsixName>rxdk-vs-@(_RxdkVsixVersion).vsix</_RxdkVsixName>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFiles="$(OutDir)$(_RxdkVsixName)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="RXDK: published $(OutDir)$(_RxdkVsixName)" />
  </Target>
</Project>
