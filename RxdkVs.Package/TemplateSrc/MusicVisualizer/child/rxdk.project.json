{
  "name": "vorbis",
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "type": "library",
      "configuration": "debug",
      "sources": [
        "src/stb_vorbis_impl.c",
        "src/vorbis_stream.c"
      ],
      "publicIncludePaths": [
        "include"
      ],
      "includePaths": [
        "vendor"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Debug"
    },
    "Release": {
      "type": "library",
      "configuration": "release",
      "sources": [
        "src/stb_vorbis_impl.c",
        "src/vorbis_stream.c"
      ],
      "publicIncludePaths": [
        "include"
      ],
      "includePaths": [
        "vendor"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Release"
    }
  }
}
