<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- *******************************************************************************************
        Link
       ******************************************************************************************* -->
  
  <!-- Default link options -->
  <ItemDefinitionGroup>
    <Link>
      
      <!-- Overridden -->
      <Machine>PPCBE</Machine>
      <OutputFile Condition="'$(OutputFile)'!=''">$(OutputFile)</OutputFile>
      <ManifestFile></ManifestFile>

      <RandomizedBaseAddress>false</RandomizedBaseAddress>
      <DataExecutionPrevention>false</DataExecutionPrevention>
      <ProfileGuidedDatabase></ProfileGuidedDatabase>

      <IgnoreAllDefaultLibraries Condition="'%(Link.IgnoreAllDefaultLibraries)' == ''">false</IgnoreAllDefaultLibraries>
      <GenerateDebugInformation  Condition="'%(Link.GenerateDebugInformation)'  == ''">false</GenerateDebugInformation>
      <StackCommitSize           Condition="'%(Link.StackCommitSize)'           == ''">262144</StackCommitSize>
      <LinkTimeCodeGeneration    Condition="'%(Link.LinkTimeCodeGeneration)'    == ''">Default</LinkTimeCodeGeneration>
      <ProfileGuidedDatabase     Condition="'%(Link.ProfileGuidedDatabase)'     == ''">$(TargetDir)$(TargetName).pgd</ProfileGuidedDatabase>
      <LinkErrorReporting        Condition="'%(Link.LinkErrorReporting)'              == '' and
                                              '$(BuildingInsideVisualStudio)'       == 'true'">PromptImmediately</LinkErrorReporting>
      <LinkErrorReporting        Condition="'%(Link.LinkErrorReporting)'          == ''">QueueForNextLogin</LinkErrorReporting>
      <AdditionalOptions         Condition="'%(Link.AdditionalOptions)'        == ''">/XEX:NO</AdditionalOptions>

      <!-- Additional -->
      <AutomaticModuleDefinitionFile Condition="'%(Link.AutomaticModuleDefinitionFile)' == ''"></AutomaticModuleDefinitionFile>
      
    </Link>
  </ItemDefinitionGroup>

</Project>
