<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- *******************************************************************************************
        Lib
       ******************************************************************************************* -->
  
  <!-- Default lib options -->
  <ItemDefinitionGroup>
    <Lib>
      
      <OutputFile                Condition="'$(OutputFile)'                    != ''">$(OutputFile)</OutputFile>
      <IgnoreAllDefaultLibraries Condition="'%(Lib.IgnoreAllDefaultLibraries)' == ''">false</IgnoreAllDefaultLibraries>
      <UseUnicodeResponseFiles   Condition="'%(Lib.UseUnicodeResponseFiles)'   == ''">true</UseUnicodeResponseFiles>
      
    </Lib>
  </ItemDefinitionGroup>

</Project>
