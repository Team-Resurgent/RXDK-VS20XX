<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Original Xbox Plugin</Name>
    <Description>A dynamic library / plugin (.xbs) for the original Xbox - a PE DLL a host loads and resolves exports from by name. Edit plugin.def to control the export table. Builds with the RXDK clean-room toolchain. (Loadable by RXDK-based hosts; not ABI-compatible with MSVC/VC7.1 hosts.)</Description>
    <Icon>Icon.png</Icon>
    <ProjectType>VC</ProjectType>
    <ProjectSubType></ProjectSubType>
    <SortOrder>1025</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>XboxPlugin</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>library</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.vcxproj" File="Plugin.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="$safeprojectname$.vcxproj.filters">Plugin.vcxproj.filters</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="plugin.def">plugin.def</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="false" TargetFileName="plugin.cpp">plugin.cpp</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
