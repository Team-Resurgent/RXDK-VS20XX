<?xml version="1.0" encoding="utf-8"?>
<!--
  RXDK "Xbox" platform props.

  A thin alias to the installed x64 platform (so the VC project system loads and IntelliSense
  works), PLUS the RXDK build integration that used to be copied into every project as
  Rxdk.Xbox.props. Installed into <VCTargetsPath>\Platforms\Xbox by the "Install Xbox Platform"
  command and imported automatically for any Platform=Xbox / ConfigurationType=Makefile project —
  so projects no longer carry per-project props/targets/rule files.

  Visual Studio owns the project system (Solution Explorer, IntelliSense, Build menu, Error List,
  F5), but the compile is delegated to Rxdk.Cli.exe, which runs the clean-room clang (LLVM) pipeline against
  our own headers/libs. cl.exe does NOT compile the title (our libs are GNU-ABI and can't be linked
  by MSVC); it only powers the IDE.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Base platform behaviour + toolset/IntelliSense: alias x64. -->
  <Import Project="$(VCTargetsPath)\Platforms\x64\Platform.props" />

  <PropertyGroup>
    <!-- Marker so the RXDK VS extension recognizes this as an Xbox project and routes F5 /
         the green Run button to the Xbox debug adapter instead of the Local Windows Debugger. -->
    <RxdkXbox>true</RxdkXbox>

    <!-- Rxdk.Cli.exe: env override wins, else the published ProgramData engine dir. -->
    <RxdkCli Condition="'$(RXDK_TOOLS_DIR)' != ''">$(RXDK_TOOLS_DIR)\Rxdk.Cli.exe</RxdkCli>
    <RxdkCli Condition="'$(RxdkCli)' == ''">$(ProgramData)\RXDK\engine\Rxdk.Cli.exe</RxdkCli>

    <!-- Clean-room RXDK SDK headers, for IntelliSense (the same dir the build compiles against). -->
    <RxdkSdkInclude>$(ProgramData)\RXDK\sdk\include</RxdkSdkInclude>

    <!-- IntelliSense-only shim headers (freestanding stddef/stdarg/float, pshpack, and the
         rxdk_intellisense.h prelude) that let the MSVC IntelliSense front-end parse the clang-built
         SDK headers. Never used by the real build. -->
    <RxdkIntelliSenseInclude>$(ProgramData)\RXDK\sdk\intellisense</RxdkIntelliSenseInclude>

    <!-- Build flavor drives the SDK library variant (debug/release). The engine derives the compiler
         optimize level from this same flag, so there is no separate optimize knob. -->
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == '' and '$(Configuration)' == 'Debug'">Debug</RxdkBuildFlavor>
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == ''">Release</RxdkBuildFlavor>
    <RxdkConfig Condition="'$(RxdkBuildFlavor)' == 'Debug'">debug</RxdkConfig>
    <RxdkConfig Condition="'$(RxdkConfig)' == ''">release</RxdkConfig>

    <!-- Classic XDK "$(D)" token: Debug libs live in the same flat sdk\lib as Release, distinguished
         only by this suffix on the filename (libd3d8d.lib vs libd3d8.lib). A project's RxdkLibraries
         names the exact file it wants using this token — same as a real "Additional Dependencies"
         list — the engine never appends it on its own. -->
    <RxdkLibSuffix Condition="'$(RxdkBuildFlavor)' == 'Debug'">d</RxdkLibSuffix>
    <RxdkLibSuffix Condition="'$(RxdkLibSuffix)' == ''"></RxdkLibSuffix>

    <!-- Build-manifest defaults (a project overrides RxdkType/RxdkLibraries/etc. as needed). -->
    <RxdkType Condition="'$(RxdkType)' == ''">executable</RxdkType>
    <RxdkStackSize Condition="'$(RxdkStackSize)' == ''">65536</RxdkStackSize>
    <RxdkImageDebug Condition="'$(RxdkImageDebug)' == ''">true</RxdkImageDebug>
    <RxdkNoLogo Condition="'$(RxdkNoLogo)' == ''">true</RxdkNoLogo>
    <RxdkNoLibWarn Condition="'$(RxdkNoLibWarn)' == ''">true</RxdkNoLibWarn>
    <RxdkLimitMemory Condition="'$(RxdkLimitMemory)' == ''">false</RxdkLimitMemory>
    <RxdkDontModifyHardDisk Condition="'$(RxdkDontModifyHardDisk)' == ''">false</RxdkDontModifyHardDisk>
    <RxdkDontMountUtilityDrive Condition="'$(RxdkDontMountUtilityDrive)' == ''">false</RxdkDontMountUtilityDrive>
    <RxdkFormatUtilityDrive Condition="'$(RxdkFormatUtilityDrive)' == ''">false</RxdkFormatUtilityDrive>
    <RxdkUtilityDriveClusterSize Condition="'$(RxdkUtilityDriveClusterSize)' == ''">0</RxdkUtilityDriveClusterSize>

    <!-- Deployment: pack an .iso via xdvdfs after the .xbe (set false to stop at the .xbe). -->
    <RxdkCreateIso Condition="'$(RxdkCreateIso)' == ''">true</RxdkCreateIso>

    <!-- Force Copy: false (default) = incremental deploy (xbcp -d, only new/newer files); true = always overwrite. -->
    <RxdkForceCopy Condition="'$(RxdkForceCopy)' == ''">false</RxdkForceCopy>

    <!-- Per-configuration output directory. Artifacts land in out\<Configuration>\ (the manifest's
         per-config outputDir), so Debug and Release don't clobber each other. -->
    <RxdkOutDir Condition="'$(RxdkOutDir)' == ''">out\$(Configuration)</RxdkOutDir>
    <OutDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</IntDir>
  </PropertyGroup>

  <!-- Makefile-project command lines + IntelliSense standard. RxdkGenerateProjectJson (below) writes
       the committed rxdk.project.json from the .vcxproj before the build; the engine then reads that
       and selects the configuration — the exact same call the VS Code / Open Folder flows make, so
       all three share one build path. -->
  <PropertyGroup>
    <NMakeBuildCommandLine>"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --configuration $(Configuration)</NMakeBuildCommandLine>
    <!-- Rebuild = Clean + Build: wipe out\ (objects + depfiles) first so the engine's incremental
         compile can't short-circuit, matching the from-scratch semantics users expect of Rebuild. -->
    <NMakeReBuildCommandLine>if exist "$(MSBuildProjectDirectory)\out" rmdir /S /Q "$(MSBuildProjectDirectory)\out"
"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --configuration $(Configuration)</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist "$(MSBuildProjectDirectory)\out" rmdir /S /Q "$(MSBuildProjectDirectory)\out"</NMakeCleanCommandLine>
    <!-- IntelliSense parses with the MSVC front-end; give it the MSVC standard switch. The clang
         '-std=c++23' the real build uses is not understood here. -->
    <AdditionalOptions>/std:c++latest</AdditionalOptions>
  </PropertyGroup>

  <!-- The IntelliSense NMake* properties depend on the project's per-config Rxdk* settings and must
       be applied AFTER Microsoft.Cpp.targets, so import them via ForceImportAfterCppTargets. The
       sheet lives in this platform folder (no per-project copy). -->
  <PropertyGroup>
    <ForceImportAfterCppTargets Condition="'$(ForceImportAfterCppTargets)' == ''">$(MSBuildThisFileDirectory)Rxdk.Xbox.IntelliSense.props</ForceImportAfterCppTargets>
  </PropertyGroup>

  <!-- Relabel the green Run button / debug-target dropdown to "Xbox Debugger (RXDK)". -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkDebugger.xml" />
  </ItemGroup>
  <PropertyGroup>
    <DebuggerFlavor>RxdkXboxDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Every project reference is BUILD-ORDER-ONLY (RXDK links it via the manifest instead). -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- RXDK project property pages (Xbox Image / Deployment / Certificate / Title Info). -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxBuild.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxImage.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxCertificate.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxTitleInfo.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxDeployment.xml"><Context>Project</Context></PropertyPageSchema>
  </ItemGroup>

  <!-- Committed rxdk.project.json generation lives in Platform.PROPS (not Platform.targets): RXDK
       projects are ConfigurationType=Makefile and Microsoft.Cpp.targets skips the platform's
       Platform.targets for them, but Platform.props is always imported.

       MSBuild evaluates one Configuration|Platform at a time, so a single evaluation can't see both
       Debug and Release. RxdkGenerateProjectJson re-enters the project once per ProjectConfiguration
       (via the <MSBuild> task -> _RxdkCollectConfig), collecting each config's fully-evaluated Rxdk*
       properties + @(ClCompile), then RxdkWriteProjectJson merges them into ONE multi-config
       rxdk.project.json at the project root — the same committed file VS Code / Open Folder use.
       Fields identical across all configs are hoisted to the top level; only the ones that differ
       (configuration, outputDir, per-config defines, …) stay under "configurations". -->
  <UsingTask TaskName="RxdkWriteProjectJson" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile ParameterType="System.String" Required="true" />
      <Name ParameterType="System.String" Required="true" />
      <DefaultConfiguration ParameterType="System.String" />
      <!-- One item per configuration; ItemSpec = config name (e.g. "Debug"), all fields as metadata. -->
      <Configs ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (Configs != null && Configs.Length > 0) {
        Func<string,string> esc = s => (s ?? "").Replace("\\","\\\\").Replace("\"","\\\"");
        Func<string,string[]> split = s => string.IsNullOrEmpty(s)
            ? new string[0]
            : s.Split(new[]{';'}, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToArray();
        Func<IEnumerable<string>,string> arr = items => "[" + string.Join(", ", items.Select(x => "\"" + esc(x) + "\"")) + "]";

        // One config item -> its ordered (jsonKey, jsonValue) pairs. Same field logic the old
        // single-config writer used, reading each value from item metadata instead of a task param.
        Func<ITaskItem,List<KeyValuePair<string,string>>> fields = cfg => {
            var f = new List<KeyValuePair<string,string>>();
            Action<string,string> add = (k,v) => f.Add(new KeyValuePair<string,string>(k,v));
            Func<string,string> M = key => cfg.GetMetadata(key);
            var type = M("Type");
            if (!string.IsNullOrEmpty(type) && type != "executable") add("type", "\"" + esc(type) + "\"");
            var configuration = M("ConfigVariant");
            if (!string.IsNullOrEmpty(configuration)) add("configuration", "\"" + esc(configuration) + "\"");
            add("sources", arr(split(M("Sources"))));
            var resources = split(M("Resources"));
            if (resources.Length > 0) add("resources", arr(resources));
            var libs = split(M("Libraries"));
            if (libs.Length > 0) add("libraries", arr(libs));
            var libPaths = split(M("LibraryPaths"));
            if (libPaths.Length > 0) add("libraryPaths", arr(libPaths));
            var addLibs = split(M("AdditionalLibraries"));
            if (addLibs.Length > 0) add("additionalLibraries", arr(addLibs));
            var pinc = split(M("PublicIncludePaths"));
            if (pinc.Length > 0) add("publicIncludePaths", arr(pinc));
            var inc = split(M("IncludePaths"));
            if (inc.Length > 0) add("includePaths", arr(inc));
            var defs = split(M("Defines"));
            if (defs.Length > 0) add("defines", arr(defs));
            var cpp = M("CppStandard");
            if (!string.IsNullOrWhiteSpace(cpp)) add("cppStandard", "\"" + esc(cpp.Trim()) + "\"");
            var exc = M("Exceptions");
            if (!string.IsNullOrWhiteSpace(exc)) add("exceptions", exc.Trim().ToLowerInvariant() == "true" ? "true" : "false");
            var incr = M("Incremental");
            if (!string.IsNullOrWhiteSpace(incr)) add("incremental", incr.Trim().ToLowerInvariant() == "true" ? "true" : "false");
            var prefs = split(M("ProjectReferences"));
            if (prefs.Length > 0) add("projectReferences", arr(prefs));
            var deploys = split(M("DeployPaths"));
            if (deploys.Length > 0) add("deployPaths", arr(deploys));
            var embeds = split(M("Embed"));
            if (embeds.Length > 0) {
                var parts = embeds.Select(e => {
                    var kv = e.Split('|');
                    var p = kv[0].Trim();
                    var nm = (kv.Length > 1 ? kv[1] : kv[0]).Trim();
                    return "{ \"path\": \"" + esc(p) + "\", \"name\": \"" + esc(nm) + "\" }";
                });
                add("embed", "[" + string.Join(", ", parts) + "]");
            }
            var createIso = M("CreateIso");
            if (!string.IsNullOrEmpty(createIso)) add("createIso", createIso.ToLowerInvariant());
            var forceCopy = M("ForceCopy");
            if (!string.IsNullOrEmpty(forceCopy)) add("forceCopy", forceCopy.ToLowerInvariant());
            var ib = new List<string>();
            Action<string,string> ibBool = (k,v) => { if (!string.IsNullOrEmpty(v)) ib.Add("\"" + k + "\": " + v.ToLowerInvariant()); };
            if (!string.IsNullOrEmpty(M("StackSize"))) ib.Add("\"stackSize\": " + M("StackSize"));
            ibBool("debug", M("ImageDebug"));
            ibBool("noLogo", M("NoLogo"));
            ibBool("noLibWarn", M("NoLibWarn"));
            ibBool("limitMemory", M("LimitMemory"));
            ibBool("dontModifyHardDisk", M("DontModifyHardDisk"));
            ibBool("dontMountUtilityDrive", M("DontMountUtilityDrive"));
            ibBool("formatUtilityDrive", M("FormatUtilityDrive"));
            if (!string.IsNullOrEmpty(M("UtilityDriveClusterSize")) && M("UtilityDriveClusterSize") != "0")
                ib.Add("\"utilityDriveClusterSize\": " + M("UtilityDriveClusterSize"));
            var noPreload = split(M("NoPreload"));
            if (noPreload.Length > 0) ib.Add("\"noPreload\": " + arr(noPreload));
            Action<string,string> ibStr = (k,v) => { if (!string.IsNullOrEmpty(v)) ib.Add("\"" + k + "\": \"" + esc(v) + "\""); };
            ibStr("testId", M("TestId"));
            ibStr("testAltId", M("TestAltId"));
            ibStr("testRegion", M("TestRegion"));
            ibStr("testRatings", M("TestRatings"));
            ibStr("testMediaTypes", M("TestMediaTypes"));
            ibStr("testLanKey", M("TestLanKey"));
            ibStr("testSignKey", M("TestSignKey"));
            ibStr("testName", M("TestName"));
            ibStr("testVersion", M("TestVersion"));
            ibStr("titleInfo", M("TitleInfo"));
            ibStr("titleImage", M("TitleImage"));
            ibStr("defaultSaveImage", M("DefaultSaveImage"));
            if (ib.Count > 0) add("imageBuild", "{ " + string.Join(", ", ib) + " }");
            var outDir = M("OutputDir");
            add("outputDir", "\"" + esc(string.IsNullOrEmpty(outDir) ? "out" : outDir) + "\"");
            return f;
        };

        var cfgNames = Configs.Select(c => c.ItemSpec).ToList();
        var perCfg = new Dictionary<string,List<KeyValuePair<string,string>>>();
        foreach (var c in Configs) perCfg[c.ItemSpec] = fields(c);

        // A (key,value) pair is common when every config carries that key with an identical value.
        var orderedKeys = new List<string>();
        foreach (var name in cfgNames)
            foreach (var p in perCfg[name])
                if (!orderedKeys.Contains(p.Key)) orderedKeys.Add(p.Key);
        var common = new List<KeyValuePair<string,string>>();
        var commonKeys = new HashSet<string>();
        foreach (var key in orderedKeys) {
            string val = null; bool ok = true; bool first = true;
            foreach (var name in cfgNames) {
                var hit = perCfg[name].FirstOrDefault(p => p.Key == key);
                if (hit.Key == null) { ok = false; break; }
                if (first) { val = hit.Value; first = false; }
                else if (val != hit.Value) { ok = false; break; }
            }
            if (ok) { common.Add(new KeyValuePair<string,string>(key, val)); commonKeys.Add(key); }
        }

        var sb = new StringBuilder();
        sb.Append("{\n");
        sb.Append("  \"name\": \"" + esc(Name) + "\",\n");
        var def = string.IsNullOrEmpty(DefaultConfiguration) ? cfgNames.Last() : DefaultConfiguration;
        sb.Append("  \"defaultConfiguration\": \"" + esc(def) + "\",\n");
        foreach (var p in common) sb.Append("  \"" + p.Key + "\": " + p.Value + ",\n");
        sb.Append("  \"configurations\": {\n");
        for (int i = 0; i < cfgNames.Count; i++) {
            var name = cfgNames[i];
            var pairs = perCfg[name].Where(p => !commonKeys.Contains(p.Key)).ToList();
            sb.Append("    \"" + esc(name) + "\": {");
            if (pairs.Count > 0) {
                sb.Append("\n");
                for (int j = 0; j < pairs.Count; j++)
                    sb.Append("      \"" + pairs[j].Key + "\": " + pairs[j].Value + (j < pairs.Count - 1 ? "," : "") + "\n");
                sb.Append("    }");
            } else {
                sb.Append("}");
            }
            sb.Append(i < cfgNames.Count - 1 ? ",\n" : "\n");
        }
        sb.Append("  }\n");
        sb.Append("}\n");

        var json = sb.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != json)
            File.WriteAllText(OutputFile, json);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Collect ONE configuration's fully-evaluated fields into a single item (all values as metadata).
       Invoked once per config by RxdkGenerateProjectJson via the <MSBuild> task, so each invocation
       is a fresh per-config evaluation with the correct Rxdk* defaults and @(ClCompile). -->
  <Target Name="_RxdkCollectConfig" Returns="@(RxdkOneConfig)">
    <ItemGroup>
      <RxdkResourceFile Include="@(None)" Condition="'%(Extension)' == '.rdf' or '%(Extension)' == '.xap'" />
      <!-- A Link item exists only so the ItemDefinitionGroup's <Link> defaults (a project's own
           AdditionalDependencies / AdditionalLibraryDirectories — the real VC++ Linker property
           names, so the standard "Additional Dependencies"-style editing flow works) become
           readable metadata: Makefile projects never emit a real linker invocation, so MSBuild
           never creates @(Link) on its own. -->
      <Link Include="$(MSBuildProjectName)" />
    </ItemGroup>
    <PropertyGroup>
      <!-- ClCompile items are the project's real source files (@(ClCompile) below), which all
           share the same ItemDefinitionGroup-derived AdditionalIncludeDirectories /
           PreprocessorDefinitions unless a template overrides them per-file (none do) —
           ->Distinct() collapses the per-file duplicates down to that one shared value. -->
      <RxdkResolvedIncludePaths>@(ClCompile->'%(AdditionalIncludeDirectories)'->Distinct())</RxdkResolvedIncludePaths>
      <RxdkResolvedDefines>@(ClCompile->'%(PreprocessorDefinitions)'->Distinct())</RxdkResolvedDefines>
      <RxdkResolvedLibraries>@(Link->'%(AdditionalDependencies)'->Distinct())</RxdkResolvedLibraries>
      <RxdkResolvedLibraryPaths>@(Link->'%(AdditionalLibraryDirectories)'->Distinct())</RxdkResolvedLibraryPaths>
    </PropertyGroup>
    <ItemGroup>
      <RxdkOneConfig Include="$(Configuration)">
        <Type>$(RxdkType)</Type>
        <ConfigVariant>$(RxdkConfig)</ConfigVariant>
        <OutputDir>$(RxdkOutDir)</OutputDir>
        <Sources>@(ClCompile)</Sources>
        <Resources>@(RxdkResourceFile)</Resources>
        <Libraries>$(RxdkResolvedLibraries)</Libraries>
        <LibraryPaths>$(RxdkResolvedLibraryPaths)</LibraryPaths>
        <AdditionalLibraries>$(RxdkAdditionalLibraries)</AdditionalLibraries>
        <PublicIncludePaths>$(RxdkPublicIncludePaths)</PublicIncludePaths>
        <IncludePaths>$(RxdkResolvedIncludePaths)</IncludePaths>
        <Defines>$(RxdkResolvedDefines)</Defines>
        <CppStandard>$(RxdkCppStandard)</CppStandard>
        <Exceptions>$(RxdkExceptions)</Exceptions>
        <Incremental>$(RxdkIncrementalBuild)</Incremental>
        <ProjectReferences>$(RxdkProjectReferences);@(ProjectReference->'%(RelativeDir)')</ProjectReferences>
        <DeployPaths>$(RxdkDeployPaths)</DeployPaths>
        <Embed>$(RxdkEmbed)</Embed>
        <CreateIso>$(RxdkCreateIso)</CreateIso>
        <ForceCopy>$(RxdkForceCopy)</ForceCopy>
        <StackSize>$(RxdkStackSize)</StackSize>
        <ImageDebug>$(RxdkImageDebug)</ImageDebug>
        <NoLogo>$(RxdkNoLogo)</NoLogo>
        <NoLibWarn>$(RxdkNoLibWarn)</NoLibWarn>
        <LimitMemory>$(RxdkLimitMemory)</LimitMemory>
        <DontModifyHardDisk>$(RxdkDontModifyHardDisk)</DontModifyHardDisk>
        <DontMountUtilityDrive>$(RxdkDontMountUtilityDrive)</DontMountUtilityDrive>
        <FormatUtilityDrive>$(RxdkFormatUtilityDrive)</FormatUtilityDrive>
        <UtilityDriveClusterSize>$(RxdkUtilityDriveClusterSize)</UtilityDriveClusterSize>
        <NoPreload>$(RxdkNoPreload)</NoPreload>
        <TestId>$(RxdkTestId)</TestId>
        <TestAltId>$(RxdkTestAltId)</TestAltId>
        <TestRegion>$(RxdkTestRegion)</TestRegion>
        <TestRatings>$(RxdkTestRatings)</TestRatings>
        <TestMediaTypes>$(RxdkTestMediaTypes)</TestMediaTypes>
        <TestLanKey>$(RxdkTestLanKey)</TestLanKey>
        <TestSignKey>$(RxdkTestSignKey)</TestSignKey>
        <TestName>$(RxdkTestName)</TestName>
        <TestVersion>$(RxdkTestVersion)</TestVersion>
        <TitleInfo>$(RxdkTitleInfo)</TitleInfo>
        <TitleImage>$(RxdkTitleImage)</TitleImage>
        <DefaultSaveImage>$(RxdkDefaultSaveImage)</DefaultSaveImage>
      </RxdkOneConfig>
    </ItemGroup>
  </Target>

  <Target Name="RxdkGenerateProjectJson" BeforeTargets="Build;Rebuild">
    <!-- Re-enter the project once per Xbox-platform ProjectConfiguration (batched over the metadata),
         collecting each config's fields. TargetOutputs accumulate into @(RxdkConfigResult). The extra
         _RxdkCollect global property guarantees each collection runs as its own project instance,
         distinct from the in-progress build (this target runs BeforeTargets="Build"), so re-entering
         the currently-building configuration can never collide with it. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Condition="'%(ProjectConfiguration.Platform)' == '$(Platform)'"
             Properties="Configuration=%(ProjectConfiguration.Configuration);Platform=%(ProjectConfiguration.Platform);_RxdkCollect=true"
             Targets="_RxdkCollectConfig">
      <Output TaskParameter="TargetOutputs" ItemName="RxdkConfigResult" />
    </MSBuild>
    <RxdkWriteProjectJson
      OutputFile="$(MSBuildProjectDirectory)\rxdk.project.json"
      Name="$(MSBuildProjectName)"
      DefaultConfiguration="Release"
      Configs="@(RxdkConfigResult)" />
  </Target>

  <Target Name="RxdkRunPreBuildEvent" BeforeTargets="Build;Rebuild" Condition="'$(RxdkPreBuildEvent)' != ''">
    <Exec Command="$(RxdkPreBuildEvent)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="RxdkRunPostBuildEvent" AfterTargets="Build;Rebuild" Condition="'$(RxdkPostBuildEvent)' != ''">
    <Exec Command="$(RxdkPostBuildEvent)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
