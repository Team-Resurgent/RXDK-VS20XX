<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Original Xbox DXT</Name>
    <Description>A debug-monitor extension (.dxt) that xbdm loads from E:\dxt at boot - e.g. an on-screen overlay. Builds with the RXDK clean-room Zig toolchain.</Description>
    <Icon>Icon.png</Icon>
    <ProjectType>VC</ProjectType>
    <ProjectSubType></ProjectSubType>
    <SortOrder>1030</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>XboxDxt</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>games</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.vcxproj" File="Dxt.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="$safeprojectname$.vcxproj.filters">Dxt.vcxproj.filters</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="false" TargetFileName="main.c">main.c</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="defines.h">defines.h</ProjectItem>
        <ProjectItem ReplaceParameters="false" TargetFileName="font.h">font.h</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
