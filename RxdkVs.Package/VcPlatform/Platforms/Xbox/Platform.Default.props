<?xml version="1.0" encoding="utf-8"?>
<!--
  RXDK "Xbox" MSBuild platform — a thin alias to the installed x64 platform.

  RXDK titles are ConfigurationType=Makefile projects whose real build is delegated to
  Rxdk.Cli (clang/LLVM); the x64 MSVC toolset is imported only so Visual Studio can drive
  IntelliSense. Aliasing x64 (rather than hand-authoring platform content) keeps this
  correct across VS versions and toolsets. Installed into <VCTargetsPath>\Platforms\Xbox.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Platforms\x64\Platform.Default.props" />
</Project>
