<?xml version="1.0" encoding="utf-8"?>
<!--
  RXDK "Xbox" platform props.

  A thin alias to the installed x64 platform (so the VC project system loads and IntelliSense
  works), PLUS the RXDK build integration that used to be copied into every project as
  Rxdk.Xbox.props. Installed into <VCTargetsPath>\Platforms\Xbox by the "Install Xbox Platform"
  command and imported automatically for any Platform=Xbox / ConfigurationType=Makefile project —
  so projects no longer carry per-project props/targets/rule files.

  Visual Studio owns the project system (Solution Explorer, IntelliSense, Build menu, Error List,
  F5), but the compile is delegated to Rxdk.Cli.exe, which runs the clean-room Zig pipeline against
  our own headers/libs. cl.exe does NOT compile the title (our libs are GNU-ABI and can't be linked
  by MSVC); it only powers the IDE.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Base platform behaviour + toolset/IntelliSense: alias x64. -->
  <Import Project="$(VCTargetsPath)\Platforms\x64\Platform.props" />

  <PropertyGroup>
    <!-- Marker so the RXDK VS extension recognizes this as an Xbox project and routes F5 /
         the green Run button to the Xbox debug adapter instead of the Local Windows Debugger. -->
    <RxdkXbox>true</RxdkXbox>

    <!-- Rxdk.Cli.exe: env override wins, else the published ProgramData engine dir. -->
    <RxdkCli Condition="'$(RXDK_TOOLS_DIR)' != ''">$(RXDK_TOOLS_DIR)\Rxdk.Cli.exe</RxdkCli>
    <RxdkCli Condition="'$(RxdkCli)' == ''">$(ProgramData)\RXDK\engine\Rxdk.Cli.exe</RxdkCli>

    <!-- Clean-room Zig SDK headers, for IntelliSense (the same dir the build compiles against). -->
    <RxdkSdkInclude>$(ProgramData)\RXDK\sdk\include</RxdkSdkInclude>

    <!-- IntelliSense-only shim headers (freestanding stddef/stdarg/float, pshpack, and the
         rxdk_intellisense.h prelude) that let the MSVC IntelliSense front-end parse the clang-built
         SDK headers. Never used by the real build. -->
    <RxdkIntelliSenseInclude>$(ProgramData)\RXDK\sdk\intellisense</RxdkIntelliSenseInclude>

    <!-- Build flavor drives BOTH the SDK library variant (debug/release) and the optimize base. -->
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == '' and '$(Configuration)' == 'Debug'">Debug</RxdkBuildFlavor>
    <RxdkBuildFlavor Condition="'$(RxdkBuildFlavor)' == ''">Release</RxdkBuildFlavor>
    <RxdkReleaseOptimize Condition="'$(RxdkReleaseOptimize)' == ''">ReleaseFast</RxdkReleaseOptimize>
    <RxdkOptimize Condition="'$(RxdkBuildFlavor)' == 'Debug'">Debug</RxdkOptimize>
    <RxdkOptimize Condition="'$(RxdkOptimize)' == ''">$(RxdkReleaseOptimize)</RxdkOptimize>
    <RxdkConfig Condition="'$(RxdkBuildFlavor)' == 'Debug'">debug</RxdkConfig>
    <RxdkConfig Condition="'$(RxdkConfig)' == ''">release</RxdkConfig>

    <!-- Build-manifest defaults (a project overrides RxdkType/RxdkLibraries/etc. as needed). -->
    <RxdkType Condition="'$(RxdkType)' == ''">executable</RxdkType>
    <RxdkStackSize Condition="'$(RxdkStackSize)' == ''">65536</RxdkStackSize>
    <RxdkImageDebug Condition="'$(RxdkImageDebug)' == ''">true</RxdkImageDebug>
    <RxdkNoLogo Condition="'$(RxdkNoLogo)' == ''">true</RxdkNoLogo>
    <RxdkNoLibWarn Condition="'$(RxdkNoLibWarn)' == ''">true</RxdkNoLibWarn>
    <RxdkLimitMemory Condition="'$(RxdkLimitMemory)' == ''">false</RxdkLimitMemory>
    <RxdkDontModifyHardDisk Condition="'$(RxdkDontModifyHardDisk)' == ''">false</RxdkDontModifyHardDisk>
    <RxdkDontMountUtilityDrive Condition="'$(RxdkDontMountUtilityDrive)' == ''">false</RxdkDontMountUtilityDrive>
    <RxdkFormatUtilityDrive Condition="'$(RxdkFormatUtilityDrive)' == ''">false</RxdkFormatUtilityDrive>
    <RxdkUtilityDriveClusterSize Condition="'$(RxdkUtilityDriveClusterSize)' == ''">0</RxdkUtilityDriveClusterSize>

    <!-- Deployment: pack an .iso via xdvdfs after the .xbe (set false to stop at the .xbe). -->
    <RxdkCreateIso Condition="'$(RxdkCreateIso)' == ''">true</RxdkCreateIso>

    <!-- Force Copy: false (default) = incremental deploy (xbcp -d, only new/newer files); true = always overwrite. -->
    <RxdkForceCopy Condition="'$(RxdkForceCopy)' == ''">false</RxdkForceCopy>

    <!-- Per-configuration output directory. Artifacts land here; the build manifest stays at the
         stable out\ path below so referenced library projects are always found. -->
    <RxdkOutDir Condition="'$(RxdkOutDir)' == ''">out\$(Configuration)</RxdkOutDir>
    <OutDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\$(RxdkOutDir)\</IntDir>

    <!-- Generated build manifest (stable out\ location, gitignored). -->
    <RxdkManifestFile>$(MSBuildProjectDirectory)\out\rxdk.manifest.json</RxdkManifestFile>
  </PropertyGroup>

  <!-- Makefile-project command lines + IntelliSense standard. The build reads the manifest that
       Platform.targets writes into out\ before the build runs. -->
  <PropertyGroup>
    <NMakeBuildCommandLine>"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --optimize $(RxdkOptimize) --manifest "$(RxdkManifestFile)"</NMakeBuildCommandLine>
    <!-- Rebuild = Clean + Build: wipe out\ (objects + depfiles) first so the engine's incremental
         compile can't short-circuit, matching the from-scratch semantics users expect of Rebuild. -->
    <NMakeReBuildCommandLine>if exist "$(MSBuildProjectDirectory)\out" rmdir /S /Q "$(MSBuildProjectDirectory)\out"
"$(RxdkCli)" build --project-root "$(MSBuildProjectDirectory)" --optimize $(RxdkOptimize) --manifest "$(RxdkManifestFile)"</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>if exist "$(MSBuildProjectDirectory)\out" rmdir /S /Q "$(MSBuildProjectDirectory)\out"</NMakeCleanCommandLine>
    <!-- IntelliSense parses with the MSVC front-end; give it the MSVC standard switch. The clang
         '-std=c++23' the real build uses is not understood here. -->
    <AdditionalOptions>/std:c++latest</AdditionalOptions>
  </PropertyGroup>

  <!-- The IntelliSense NMake* properties depend on the project's per-config Rxdk* settings and must
       be applied AFTER Microsoft.Cpp.targets, so import them via ForceImportAfterCppTargets. The
       sheet lives in this platform folder (no per-project copy). -->
  <PropertyGroup>
    <ForceImportAfterCppTargets Condition="'$(ForceImportAfterCppTargets)' == ''">$(MSBuildThisFileDirectory)Rxdk.Xbox.IntelliSense.props</ForceImportAfterCppTargets>
  </PropertyGroup>

  <!-- Relabel the green Run button / debug-target dropdown to "Xbox Debugger (RXDK)". -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkDebugger.xml" />
  </ItemGroup>
  <PropertyGroup>
    <DebuggerFlavor>RxdkXboxDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Every project reference is BUILD-ORDER-ONLY (RXDK links it via the manifest instead). -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <UseLibraryDependencyInputs>false</UseLibraryDependencyInputs>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- RXDK project property pages (Xbox Image / Deployment / Certificate / Title Info). -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxBuild.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxImage.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxCertificate.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxTitleInfo.xml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)RxdkXboxDeployment.xml"><Context>Project</Context></PropertyPageSchema>
  </ItemGroup>

  <!-- Manifest generation lives in Platform.PROPS (not Platform.targets): RXDK projects are
       ConfigurationType=Makefile and Microsoft.Cpp.targets skips the platform's Platform.targets
       for them, but Platform.props is always imported. The target runs at build time, when
       @(ClCompile) and the per-config Rxdk* properties are fully populated. -->
  <UsingTask TaskName="RxdkWriteManifest" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile ParameterType="System.String" Required="true" />
      <Name ParameterType="System.String" Required="true" />
      <Type ParameterType="System.String" />
      <Configuration ParameterType="System.String" />
      <OutputDir ParameterType="System.String" />
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <Libraries ParameterType="System.String" />
      <LibraryPaths ParameterType="System.String" />
      <AdditionalLibraries ParameterType="System.String" />
      <PublicIncludePaths ParameterType="System.String" />
      <IncludePaths ParameterType="System.String" />
      <Defines ParameterType="System.String" />
      <CppStandard ParameterType="System.String" />
      <Exceptions ParameterType="System.String" />
      <Incremental ParameterType="System.String" />
      <ProjectReferences ParameterType="System.String" />
      <DeployPaths ParameterType="System.String" />
      <Embed ParameterType="System.String" />
      <CreateIso ParameterType="System.String" />
      <ForceCopy ParameterType="System.String" />
      <StackSize ParameterType="System.String" />
      <ImageDebug ParameterType="System.String" />
      <NoLogo ParameterType="System.String" />
      <NoLibWarn ParameterType="System.String" />
      <LimitMemory ParameterType="System.String" />
      <DontModifyHardDisk ParameterType="System.String" />
      <DontMountUtilityDrive ParameterType="System.String" />
      <FormatUtilityDrive ParameterType="System.String" />
      <UtilityDriveClusterSize ParameterType="System.String" />
      <NoPreload ParameterType="System.String" />
      <TestId ParameterType="System.String" />
      <TestAltId ParameterType="System.String" />
      <TestRegion ParameterType="System.String" />
      <TestRatings ParameterType="System.String" />
      <TestMediaTypes ParameterType="System.String" />
      <TestLanKey ParameterType="System.String" />
      <TestSignKey ParameterType="System.String" />
      <TestName ParameterType="System.String" />
      <TestVersion ParameterType="System.String" />
      <TitleInfo ParameterType="System.String" />
      <TitleImage ParameterType="System.String" />
      <DefaultSaveImage ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string,string> esc = s => (s ?? "").Replace("\\","\\\\").Replace("\"","\\\"");
        Func<string,string[]> split = s => string.IsNullOrEmpty(s)
            ? new string[0]
            : s.Split(new[]{';'}, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToArray();
        Func<IEnumerable<string>,string> arr = items => "[" + string.Join(", ", items.Select(x => "\"" + esc(x) + "\"")) + "]";

        var sb = new StringBuilder();
        sb.Append("{\n");
        sb.Append("  \"name\": \"" + esc(Name) + "\",\n");
        if (!string.IsNullOrEmpty(Type) && Type != "executable")
            sb.Append("  \"type\": \"" + esc(Type) + "\",\n");
        if (!string.IsNullOrEmpty(Configuration))
            sb.Append("  \"configuration\": \"" + esc(Configuration) + "\",\n");
        var srcs = (Sources ?? new Microsoft.Build.Framework.ITaskItem[0]).Select(i => i.ItemSpec);
        sb.Append("  \"sources\": " + arr(srcs) + ",\n");
        var resources = (Resources ?? new Microsoft.Build.Framework.ITaskItem[0]).Select(i => i.ItemSpec).ToArray();
        if (resources.Length > 0) sb.Append("  \"resources\": " + arr(resources) + ",\n");
        var libs = split(Libraries);
        if (libs.Length > 0) sb.Append("  \"libraries\": " + arr(libs) + ",\n");
        var libPaths = split(LibraryPaths);
        if (libPaths.Length > 0) sb.Append("  \"libraryPaths\": " + arr(libPaths) + ",\n");
        var addLibs = split(AdditionalLibraries);
        if (addLibs.Length > 0) sb.Append("  \"additionalLibraries\": " + arr(addLibs) + ",\n");
        var pinc = split(PublicIncludePaths);
        if (pinc.Length > 0) sb.Append("  \"publicIncludePaths\": " + arr(pinc) + ",\n");
        var inc = split(IncludePaths);
        if (inc.Length > 0) sb.Append("  \"includePaths\": " + arr(inc) + ",\n");
        var defs = split(Defines);
        if (defs.Length > 0) sb.Append("  \"defines\": " + arr(defs) + ",\n");
        if (!string.IsNullOrWhiteSpace(CppStandard))
            sb.Append("  \"cppStandard\": \"" + esc(CppStandard.Trim()) + "\",\n");
        if (!string.IsNullOrWhiteSpace(Exceptions))
            sb.Append("  \"exceptions\": " + (Exceptions.Trim().ToLowerInvariant() == "true" ? "true" : "false") + ",\n");
        if (!string.IsNullOrWhiteSpace(Incremental))
            sb.Append("  \"incremental\": " + (Incremental.Trim().ToLowerInvariant() == "true" ? "true" : "false") + ",\n");
        var prefs = split(ProjectReferences);
        if (prefs.Length > 0) sb.Append("  \"projectReferences\": " + arr(prefs) + ",\n");
        var deploys = split(DeployPaths);
        if (deploys.Length > 0) sb.Append("  \"deployPaths\": " + arr(deploys) + ",\n");
        var embeds = split(Embed);
        if (embeds.Length > 0) {
            var parts = embeds.Select(e => {
                var kv = e.Split('|');
                var p = kv[0].Trim();
                var nm = (kv.Length > 1 ? kv[1] : kv[0]).Trim();
                return "{ \"path\": \"" + esc(p) + "\", \"name\": \"" + esc(nm) + "\" }";
            });
            sb.Append("  \"embed\": [" + string.Join(", ", parts) + "],\n");
        }
        if (!string.IsNullOrEmpty(CreateIso)) sb.Append("  \"createIso\": " + CreateIso.ToLowerInvariant() + ",\n");
        if (!string.IsNullOrEmpty(ForceCopy)) sb.Append("  \"forceCopy\": " + ForceCopy.ToLowerInvariant() + ",\n");
        var ib = new List<string>();
        if (!string.IsNullOrEmpty(StackSize)) ib.Add("\"stackSize\": " + StackSize);
        if (!string.IsNullOrEmpty(ImageDebug)) ib.Add("\"debug\": " + ImageDebug.ToLowerInvariant());
        if (!string.IsNullOrEmpty(NoLogo)) ib.Add("\"noLogo\": " + NoLogo.ToLowerInvariant());
        if (!string.IsNullOrEmpty(NoLibWarn)) ib.Add("\"noLibWarn\": " + NoLibWarn.ToLowerInvariant());
        if (!string.IsNullOrEmpty(LimitMemory)) ib.Add("\"limitMemory\": " + LimitMemory.ToLowerInvariant());
        if (!string.IsNullOrEmpty(DontModifyHardDisk)) ib.Add("\"dontModifyHardDisk\": " + DontModifyHardDisk.ToLowerInvariant());
        if (!string.IsNullOrEmpty(DontMountUtilityDrive)) ib.Add("\"dontMountUtilityDrive\": " + DontMountUtilityDrive.ToLowerInvariant());
        if (!string.IsNullOrEmpty(FormatUtilityDrive)) ib.Add("\"formatUtilityDrive\": " + FormatUtilityDrive.ToLowerInvariant());
        if (!string.IsNullOrEmpty(UtilityDriveClusterSize) && UtilityDriveClusterSize != "0")
            ib.Add("\"utilityDriveClusterSize\": " + UtilityDriveClusterSize);
        var noPreload = split(NoPreload);
        if (noPreload.Length > 0) ib.Add("\"noPreload\": " + arr(noPreload));
        Action<string,string> addStr = (key, val) => { if (!string.IsNullOrEmpty(val)) ib.Add("\"" + key + "\": \"" + esc(val) + "\""); };
        addStr("testId", TestId);
        addStr("testAltId", TestAltId);
        addStr("testRegion", TestRegion);
        addStr("testRatings", TestRatings);
        addStr("testMediaTypes", TestMediaTypes);
        addStr("testLanKey", TestLanKey);
        addStr("testSignKey", TestSignKey);
        addStr("testName", TestName);
        addStr("testVersion", TestVersion);
        addStr("titleInfo", TitleInfo);
        addStr("titleImage", TitleImage);
        addStr("defaultSaveImage", DefaultSaveImage);
        if (ib.Count > 0) sb.Append("  \"imageBuild\": { " + string.Join(", ", ib) + " },\n");
        sb.Append("  \"outputDir\": \"" + esc(string.IsNullOrEmpty(OutputDir) ? "out" : OutputDir) + "\"\n");
        sb.Append("}\n");

        var json = sb.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != json)
            File.WriteAllText(OutputFile, json);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RxdkGenerateManifest" BeforeTargets="Build;Rebuild">
    <ItemGroup>
      <RxdkResourceFile Include="@(None)" Condition="'%(Extension)' == '.rdf' or '%(Extension)' == '.xap'" />
    </ItemGroup>
    <RxdkWriteManifest
      OutputFile="$(RxdkManifestFile)"
      Name="$(MSBuildProjectName)"
      Type="$(RxdkType)"
      Configuration="$(RxdkConfig)"
      OutputDir="$(RxdkOutDir)"
      Sources="@(ClCompile)"
      Resources="@(RxdkResourceFile)"
      Libraries="$(RxdkLibraries)"
      LibraryPaths="$(RxdkLibraryPaths)"
      AdditionalLibraries="$(RxdkAdditionalLibraries)"
      PublicIncludePaths="$(RxdkPublicIncludePaths)"
      IncludePaths="$(RxdkIncludePaths)"
      Defines="$(RxdkDefines)"
      CppStandard="$(RxdkCppStandard)"
      Exceptions="$(RxdkExceptions)"
      Incremental="$(RxdkIncrementalBuild)"
      ProjectReferences="$(RxdkProjectReferences);@(ProjectReference->'%(RelativeDir)')"
      DeployPaths="$(RxdkDeployPaths)"
      Embed="$(RxdkEmbed)"
      CreateIso="$(RxdkCreateIso)"
      ForceCopy="$(RxdkForceCopy)"
      StackSize="$(RxdkStackSize)"
      ImageDebug="$(RxdkImageDebug)"
      NoLogo="$(RxdkNoLogo)"
      NoLibWarn="$(RxdkNoLibWarn)"
      LimitMemory="$(RxdkLimitMemory)"
      DontModifyHardDisk="$(RxdkDontModifyHardDisk)"
      DontMountUtilityDrive="$(RxdkDontMountUtilityDrive)"
      FormatUtilityDrive="$(RxdkFormatUtilityDrive)"
      UtilityDriveClusterSize="$(RxdkUtilityDriveClusterSize)"
      NoPreload="$(RxdkNoPreload)"
      TestId="$(RxdkTestId)"
      TestAltId="$(RxdkTestAltId)"
      TestRegion="$(RxdkTestRegion)"
      TestRatings="$(RxdkTestRatings)"
      TestMediaTypes="$(RxdkTestMediaTypes)"
      TestLanKey="$(RxdkTestLanKey)"
      TestSignKey="$(RxdkTestSignKey)"
      TestName="$(RxdkTestName)"
      TestVersion="$(RxdkTestVersion)"
      TitleInfo="$(RxdkTitleInfo)"
      TitleImage="$(RxdkTitleImage)"
      DefaultSaveImage="$(RxdkDefaultSaveImage)" />
  </Target>

  <Target Name="RxdkRunPreBuildEvent" BeforeTargets="Build;Rebuild" Condition="'$(RxdkPreBuildEvent)' != ''">
    <Exec Command="$(RxdkPreBuildEvent)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="RxdkRunPostBuildEvent" AfterTargets="Build;Rebuild" Condition="'$(RxdkPostBuildEvent)' != ''">
    <Exec Command="$(RxdkPostBuildEvent)" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
