<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>cubemesh</Name>
    <Description>Cube mesh geometry library (child project).</Description>
    <Icon>Icon.png</Icon>
    <Hidden>true</Hidden>
    <ProjectType>VC</ProjectType>
    <ProjectSubType></ProjectSubType>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>cubemesh</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>games</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="cubemesh.vcxproj" File="cubemesh.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="cubemesh.vcxproj.filters">cubemesh.vcxproj.filters</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="false" TargetFileName="cubemesh.cpp">cubemesh.cpp</ProjectItem>
      </Folder>
      <Folder Name="include" TargetFolderName="include">
        <ProjectItem ReplaceParameters="false" TargetFileName="cubemesh.h">cubemesh.h</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
