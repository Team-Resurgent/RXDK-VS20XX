<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Original Xbox Font Scroller</Name>
    <Description>Demoscene-style bitmap-font scroller using XFONT (in libxgraphics) - sine bounce, stretch-blit scaling, rainbow colour cycle. Builds with the RXDK clean-room Zig toolchain.</Description>
    <Icon>Icon.png</Icon>
    <ProjectType>VC</ProjectType>
    <ProjectSubType></ProjectSubType>
    <SortOrder>1050</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>XboxScroller</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <LanguageTag>C++</LanguageTag>
    <PlatformTag>xbox</PlatformTag>
    <ProjectTypeTag>games</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.vcxproj" File="FontScroller.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="$safeprojectname$.vcxproj.filters">FontScroller.vcxproj.filters</ProjectItem>
      <Folder Name="src" TargetFolderName="src">
        <ProjectItem ReplaceParameters="false" TargetFileName="main.cpp">main.cpp</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
