{
  "name": "$safeprojectname$",
  "defaultConfiguration": "Debug",
  "configurations": {
    "Debug": {
      "type": "dxt",
      "configuration": "release",
      "sources": [
        "src/main.c"
      ],
      "libraries": [
        "libxbdm",
        "libkernel",
        "libc"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Debug"
    },
    "Release": {
      "type": "dxt",
      "configuration": "release",
      "sources": [
        "src/main.c"
      ],
      "libraries": [
        "libxbdm",
        "libkernel",
        "libc"
      ],
      "createIso": true,
      "imageBuild": {
        "stackSize": 65536,
        "debug": true,
        "noLogo": true,
        "noLibWarn": true,
        "limitMemory": false,
        "dontModifyHardDisk": false,
        "dontMountUtilityDrive": false,
        "formatUtilityDrive": false
      },
      "outputDir": "out/Release"
    }
  }
}
